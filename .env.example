# AWS (uses your local aws login / profile)
AWS_PROFILE=default
AWS_REGION=ap-south-1
# GCP (uses: gcloud auth application-default login)
GCP_PROJECT_ID=ui-practice-rajib
# Cloudflare
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PROJECT_NAME=my-ui-rajib
# Validation
VALIDATE_RETRIES=10
VALIDATE_WAIT_SECONDS=15
